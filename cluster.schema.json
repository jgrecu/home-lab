    },
    "forgejo_admin_email": {
      "title": "Forgejo Admin Email",
      "type": "string"
    },
    "forgejo_admin_password": {
      "title": "Forgejo Admin Password",
      "type": "string"
    },
    "forgejo_runner_secret": {
      "title": "Forgejo Runner Secret",
      "type": "string"
    },
    "forgejo_runner_uuid": {
      "title": "Forgejo Runner Uuid",
