{
  "$defs": {
    "NodeConfig": {
      "properties": {
        "name": {
          "description": "Node hostname (lowercase, alphanumeric, hyphens)",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "description": "Static IP address (must be within node_cidr)",
          "title": "Address",
          "type": "string"
        },
        "controller": {
          "description": "True if this is a control-plane node",
          "title": "Controller",
          "type": "boolean"
        },
        "disk": {
          "description": "Disk path (/dev/...) or serial number for disk selection",
          "title": "Disk",
          "type": "string"
        },
        "mac_addr": {
          "description": "Primary NIC MAC address for network interface selection",
          "title": "Mac Addr",
          "type": "string"
        },
        "schematic_id": {
          "description": "Talos factory schematic ID from factory.talos.dev",
          "title": "Schematic Id",
          "type": "string"
        },
        "mtu": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1500,
          "description": "NIC MTU (default: 1500)",
          "title": "Mtu"
        },
        "secureboot": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "description": "Enable SecureBoot on UEFI platforms",
          "title": "Secureboot"
        },
        "encrypt_disk": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "description": "Enable TPM-based disk encryption",
          "title": "Encrypt Disk"
        },
        "kernel_modules": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Extra kernel modules",
          "title": "Kernel Modules"
        },
        "media_node": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "description": "Label for downloads/media workloads",
          "title": "Media Node"
        }
      },
      "required": [
        "name",
        "address",
        "controller",
        "disk",
        "mac_addr",
        "schematic_id"
      ],
      "title": "NodeConfig",
      "type": "object"
    }
  },
  "properties": {
    "node_cidr": {
      "description": "Node network CIDR (e.g. 192.168.1.0/24)",
      "title": "Node Cidr",
      "type": "string"
    },
    "node_dns_servers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "DNS servers (default: Cloudflare)",
      "title": "Node Dns Servers"
    },
    "node_ntp_servers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "NTP servers (default: Cloudflare)",
      "title": "Node Ntp Servers"
    },
    "node_default_gateway": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default gateway (default: first IP of node_cidr)",
      "title": "Node Default Gateway"
    },
    "node_vlan_tag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "VLAN tag for Talos nodes",
      "title": "Node Vlan Tag"
    },
    "cluster_api_addr": {
      "description": "Kubernetes API VIP (unused IP within node_cidr)",
      "title": "Cluster Api Addr",
      "type": "string"
    },
    "cluster_api_tls_sans": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Additional API server cert SANs",
      "title": "Cluster Api Tls Sans"
    },
    "cluster_pod_cidr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "10.42.0.0/16",
      "description": "Pod CIDR (must not overlap node_cidr)",
      "title": "Cluster Pod Cidr"
    },
    "cluster_svc_cidr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "10.43.0.0/16",
      "description": "Service CIDR (must not overlap node_cidr)",
      "title": "Cluster Svc Cidr"
    },
    "cluster_dns_gateway_addr": {
      "description": "Load balancer IP for k8s-gateway (split-DNS)",
      "title": "Cluster Dns Gateway Addr",
      "type": "string"
    },
    "cluster_gateway_addr": {
      "description": "Load balancer IP for internal Envoy gateway",
      "title": "Cluster Gateway Addr",
      "type": "string"
    },
    "transmission_peer_addr": {
      "description": "Load balancer IP for Transmission peer port",
      "title": "Transmission Peer Addr",
      "type": "string"
    },
    "wg_portal_vpn_addr": {
      "description": "Load balancer IP for wg-portal WireGuard VPN",
      "title": "Wg Portal Vpn Addr",
      "type": "string"
    },
    "wg_portal_admin_password": {
      "description": "wg-portal admin password (min 16 chars)",
      "title": "Wg Portal Admin Password",
      "type": "string"
    },
    "wg_portal_server_private_key": {
      "description": "WireGuard server private key (preserve to avoid reconfiguring clients)",
      "title": "Wg Portal Server Private Key",
      "type": "string"
    },
    "pihole_dns_addr": {
      "description": "Load balancer IP for Pi-hole",
      "title": "Pihole Dns Addr",
      "type": "string"
    },
    "pihole_admin_password": {
      "description": "Pi-hole admin dashboard password",
      "title": "Pihole Admin Password",
      "type": "string"
    },
    "cloudflare_gateway_addr": {
      "description": "Load balancer IP for Cloudflare Tunnel gateway",
      "title": "Cloudflare Gateway Addr",
      "type": "string"
    },
    "cloudflare_domain": {
      "description": "Cloudflare domain (e.g. example.com)",
      "title": "Cloudflare Domain",
      "type": "string"
    },
    "cloudflare_token": {
      "description": "Cloudflare API token (Zone:DNS:Edit + Tunnel:Read)",
      "title": "Cloudflare Token",
      "type": "string"
    },
    "cilium_loadbalancer_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "dsr",
      "description": "'dsr' or 'snat'",
      "title": "Cilium Loadbalancer Mode"
    },
    "cilium_bgp_router_addr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cilium Bgp Router Addr"
    },
    "cilium_bgp_router_asn": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cilium Bgp Router Asn"
    },
    "cilium_bgp_node_asn": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cilium Bgp Node Asn"
    },
    "repository_name": {
      "description": "GitHub repository (owner/name)",
      "title": "Repository Name",
      "type": "string"
    },
    "repository_branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "main",
      "title": "Repository Branch"
    },
    "repository_visibility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "public",
      "title": "Repository Visibility"
    },
    "grafana_admin_password": {
      "title": "Grafana Admin Password",
      "type": "string"
    },
    "nfs_server_addr": {
      "title": "Nfs Server Addr",
      "type": "string"
    },
    "nfs_server_path": {
      "title": "Nfs Server Path",
      "type": "string"
    },
    "nfs_media_path": {
      "title": "Nfs Media Path",
      "type": "string"
    },
    "nfs_photos_path": {
