---
clusterName: kubernetes
clusterEndpoint: https://#{ cluster_api_addr }#:6443

# renovate: datasource=github-releases depName=siderolabs/talos
talosVersion: v1.14.5
# renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
kubernetesVersion: v1.37.1

secretsPath: secrets.sops.yaml

# Global data available to .yaml.tpl patch files via {{ .Data.<key> }}
data:
  clusterApiAddr: "#{ cluster_api_addr }#"
  nodeGateway: "#{ node_default_gateway }#"
  nodeCidrPrefix: "#{ node_cidr.split('/') | last }#"

nodes:
  #% for item in nodes %#
  - host: "#{ item.name }#"
    ip: "#{ item.address }#"
    role: #{ "control-plane" if item.controller else "worker" }#
    schematicId: "#{ item.schematic_id }#"
    #% if item.secureboot | default(false, true) %#
    secureboot: true
    #% endif %#
    data:
      #% if item.disk.startswith('/') %#
      installDisk: "#{ item.disk }#"
      #% else %#
      installDiskSerial: "#{ item.disk }#"
      #% endif %#
      macAddr: "#{ item.mac_addr | lower }#"
      mtu: #{ item.mtu | default(1500, true) }#
      encryptDisk: #{ (item.encrypt_disk | default(false, true)) | string | lower }#
      mediaNode: #{ (item.media_node | default(false, true)) | string | lower }#
      #% if item.kernel_modules | default([], true) | length > 0 %#
      kernelModules:
        #% for module in item.kernel_modules %#
        - "#{ module }#"
        #% endfor %#
      #% endif %#
  #% endfor %#
