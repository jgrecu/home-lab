cluster:
  allowSchedulingOnControlPlanes: true
  network:
    podSubnets:
      - "#{ cluster_pod_cidr }#"
    serviceSubnets:
      - "#{ cluster_svc_cidr }#"
    cni:
      name: none
  coreDNS:
    disabled: true
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - #{ node_cidr }#
  apiServer:
    certSANs:
      - "127.0.0.1"
      - "#{ cluster_api_addr }#"
      #% for item in cluster_api_tls_sans | default([]) %#
      - "#{ item }#"
      #% endfor %#
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
extraArgs:
  enable-aggregator-routing: "true"
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: "0.0.0.0"
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  bind-address: "0.0.0.0"
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
