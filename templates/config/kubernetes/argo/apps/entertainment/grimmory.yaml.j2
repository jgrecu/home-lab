---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: grimmory
  namespace: argo-system
  annotations:
    argocd.argoproj.io/sync-wave: "2"
spec:
  project: kubernetes
  source:
    repoURL: "#{ 'ssh://git@github.com/' if repository_visibility == 'private' else 'https://github.com/' }##{ repository_name }#.git"
    targetRevision: "#{ repository_branch }#"
    path: kubernetes/apps/entertainment/grimmory
  destination:
    name: in-cluster
    namespace: entertainment
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
    syncOptions:
      - ApplyOutOfSyncOnly=true
      - ServerSideApply=true
      - PruneLast=true
      - RespectIgnoreDifferences=true
