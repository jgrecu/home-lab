---
# Helm values for reloader (reloader).
fullnameOverride: reloader
reloader:
  readOnlyRootFileSystem: true
  deployment:
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 128Mi
  podMonitor:
    enabled: true
    namespace: "{{ .Release.Namespace }}"
