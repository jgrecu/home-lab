---
# Helm values with the domain (fully encrypted) for app-template (cloudflare-tunnel).
configMaps:
  config:
    data:
      config.yaml: |-
        ingress:
          - hostname: "*.#{ cloudflare_domain }#"
            originRequest:
              http2Origin: true
              originServerName: external.#{ cloudflare_domain }#
            service: https://envoy-external.{{ .Release.Namespace }}.svc.cluster.local:443
          - service: http_status:404
