---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app wg-portal
  namespace: network
spec:
  chartRef:
    kind: OCIRepository
    name: wg-portal
  interval: 1h
  values:
    # Single replica required: WireGuard state is node-local kernel state.
    replicaCount: 1

    # Recreate strategy required: RWO PVC can only be mounted by one pod at a time.
    strategy:
      type: Recreate

    initContainers:
      # Pre-seed nftables tables/chains so they exist for masquerade.
      # wg-portal uses wgctrl (kernel netlink) and does NOT manage firewall rules,
      # so NAT masquerade must be set up independently before the VPN interface comes up.
      - name: nftables-setup
        image: alpine:3.21
        command:
          - /bin/sh
          - -c
          - |
            apk add --no-cache nftables
            nft add table ip nat
            nft add chain ip nat postrouting { type nat hook postrouting priority 100 \; }
            nft add rule ip nat postrouting oifname "eth0" ip saddr 10.8.0.0/24 masquerade
            nft add table ip filter
            nft add chain ip filter input { type filter hook input priority 0 \; }
            nft add rule ip filter input udp dport 51820 accept
            nft add chain ip filter forward { type filter hook forward priority 0 \; }
            nft add rule ip filter forward iifname "wg0" accept
            nft add rule ip filter forward oifname "wg0" accept
        securityContext:
          privileged: true

      # Load the WireGuard server private key into the kernel interface before wg-portal
      # starts. wg-portal's import_existing feature reads the key from the running kernel
      # interface — this preserves the existing key so current clients need no reconfiguration.
      # The key is mounted as a file from the secret to avoid Flux envsubst treating
      # shell variable references as substitution variables.
      - name: wg-key-loader
        image: alpine:3.21
        command:
          - /bin/sh
          - -c
          - |
            apk add --no-cache wireguard-tools iproute2
            echo "Loading WireGuard private key into kernel interface..."
            if ! ip link show wg0 >/dev/null 2>&1; then
              ip link add dev wg0 type wireguard
            fi
            wg set wg0 private-key /secrets/server-private-key
            wg set wg0 listen-port 51820
            ip address add 10.8.0.1/24 dev wg0 2>/dev/null || true
            ip link set mtu 1420 up dev wg0
            echo "WireGuard interface wg0 is ready for wg-portal import."
        volumeMounts:
          - name: wg-secret
            mountPath: /secrets
            readOnly: true
        securityContext:
          privileged: true

    # Volume for wg-key-loader initContainer to read the private key as a file
    volumes:
      - name: wg-secret
        secret:
          secretName: wg-portal-secret
          items:
            - key: server-private-key
              path: server-private-key

    env:
      # Database — SQLite stored on the PVC (sufficient for homelab single-replica)
      - name: WG_PORTAL_DATABASE_TYPE
        value: "sqlite"
      - name: WG_PORTAL_DATABASE_DSN
        value: "/data/sqlite.db"

      # Core settings
      - name: WG_PORTAL_CORE_ADMIN_USER
        value: "admin@wgportal.local"
      - name: WG_PORTAL_CORE_ADMIN_PASSWORD
        valueFrom:
          secretKeyRef:
            name: wg-portal-secret
            key: admin-password
      # Allow wg-portal to import the pre-loaded kernel interface and its private key
      - name: WG_PORTAL_CORE_IMPORT_EXISTING
        value: "true"
      # Allow editing keys via UI (useful for restoring the private key if PVC is lost)
      - name: WG_PORTAL_CORE_EDITABLE_KEYS
        value: "true"

      # Web server — listen on all interfaces, HTTP (behind internal HTTPS gateway)
      - name: WG_PORTAL_WEB_EXTERNAL_URL
        value: "https://wg.${SECRET_DOMAIN}"
      - name: WG_PORTAL_WEB_LISTENING_ADDRESS
        value: ":8888"

      # Built-in Prometheus metrics endpoint
      - name: WG_PORTAL_STATISTICS_LISTENING_ADDRESS
        value: ":8787"

      # WireGuard interface name
      - name: WG_PORTAL_ADVANCED_IGNORED_LOCAL_INTERFACES
        value: "eth0"

    podAnnotations:
      secret.reloader.stakater.com/reload: *app

    # Required sysctls for WireGuard routing
    podSecurityContext:
      sysctls:
        - name: net.ipv4.ip_forward
          value: "1"
        - name: net.ipv4.conf.all.src_valid_mark
          value: "1"

    securityContext:
      capabilities:
        add:
          - NET_ADMIN
      runAsNonRoot: false
      runAsUser: 0

    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        memory: 256Mi

    persistence:
      enabled: true
      storageClass: longhorn
      accessMode: ReadWriteOnce
      size: 1Gi
      mountPath: /data

    service:
      web:
        type: ClusterIP
        port: 8888
      wireguard:
        type: LoadBalancer
        annotations:
          io.cilium/lb-ipam-ips: "#{ wg_portal_vpn_addr }#"
        ports:
          - 51820
      metrics:
        port: 8787

    # Built-in Prometheus monitoring via PodMonitor — scrapes the metrics port (8787) directly
    monitoring:
      enabled: true
      apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      interval: 30s
