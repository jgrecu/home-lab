---
# Helm values for wg-portal (wg-portal).
    # Single replica required: WireGuard state is node-local kernel state.
replicaCount: 1

    # Recreate strategy required: RWO PVC can only be mounted by one pod at a time.
strategy:
  type: Recreate

initContainers:
      # Pre-seed nftables tables/chains so they exist for masquerade.
      # wg-portal uses wgctrl (kernel netlink) and does NOT manage firewall rules,
      # so NAT masquerade must be set up independently before the VPN interface comes up.
  - name: nftables-setup
    image: alpine:3.24
    command:
      - /bin/sh
      - -c
      - |
        apk add --no-cache nftables
        nft add table ip nat
        nft add chain ip nat postrouting { type nat hook postrouting priority 100 \; }
        nft add rule ip nat postrouting oifname "eth0" ip saddr 10.8.0.0/24 masquerade
        nft add table ip filter
        nft add chain ip filter input { type filter hook input priority 0 \; }
        nft add rule ip filter input udp dport 51820 accept
        nft add chain ip filter forward { type filter hook forward priority 0 \; }
        nft add rule ip filter forward iifname "wg0" accept
        nft add rule ip filter forward oifname "wg0" accept
    securityContext:
      privileged: true

      # Load the WireGuard server private key into the kernel interface before wg-portal
      # starts. wg-portal's import_existing feature reads the key from the running kernel
      # interface — this preserves the existing key so current clients need no reconfiguration.
      # The key is mounted as a file from the secret to keep shell variable
      # references out of the manifest.
  - name: wg-key-loader
    image: alpine:3.24
    command:
      - /bin/sh
      - -c
      - |
        apk add --no-cache wireguard-tools iproute2
        echo "Loading WireGuard private key into kernel interface..."
        if ! ip link show wg0 >/dev/null 2>&1; then
          ip link add dev wg0 type wireguard
        fi
        wg set wg0 private-key /secrets/server-private-key
        wg set wg0 listen-port 51820
        ip address add 10.8.0.1/24 dev wg0 2>/dev/null || true
        ip link set mtu 1420 up dev wg0
        echo "WireGuard interface wg0 is ready for wg-portal import."
    volumeMounts:
      - name: wg-secret
        mountPath: /secrets
        readOnly: true
    securityContext:
      privileged: true

    # Volume for wg-key-loader initContainer to read the private key as a file
volumes:
  - name: wg-secret
    secret:
      secretName: wg-portal-secret
      items:
        - key: server-private-key
          path: server-private-key

podAnnotations:
  secret.reloader.stakater.com/reload: &app wg-portal

    # Required sysctls for WireGuard routing
podSecurityContext:
  sysctls:
    - name: net.ipv4.ip_forward
      value: "1"
    - name: net.ipv4.conf.all.src_valid_mark
      value: "1"

securityContext:
  capabilities:
    add:
      - NET_ADMIN
  runAsNonRoot: false
  runAsUser: 0

resources:
  requests:
    cpu: 25m
    memory: 64Mi
  limits:
    memory: 256Mi

persistence:
  enabled: true
  storageClass: longhorn
  accessMode: ReadWriteOnce
  size: 1Gi
  mountPath: /data

config:
  database:
    # PVC is mounted at /app/data; without this wg-portal writes to /data (overlay, lost on restart)
    dsn: /app/data/sqlite.db
  backend:
    # Disable resolvconf: fails in the container and blocks interface saves
    local_resolvconf_prefix: ""

service:
  web:
    type: ClusterIP
    port: 8888
  wireguard:
    type: LoadBalancer
    annotations:
      io.cilium/lb-ipam-ips: "#{ wg_portal_vpn_addr }#"
    ports:
      - 51820
  metrics:
    port: 8787

    # Built-in Prometheus monitoring via PodMonitor — scrapes the metrics port (8787) directly
monitoring:
  enabled: true
  apiVersion: monitoring.coreos.com/v1
  kind: PodMonitor
  interval: 30s
