---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: wg-portal-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: wg-portal-secret
    creationPolicy: Owner
  data:
    - secretKey: admin-password
      remoteRef:
        key: wg-portal
        property: admin-password
    - secretKey: server-private-key
      remoteRef:
        key: wg-portal
        property: server-private-key
    - secretKey: oidc-client-id
      remoteRef:
        key: wg-portal
        property: oidc-client-id
    - secretKey: oidc-client-secret
      remoteRef:
        key: wg-portal
        property: oidc-client-secret
