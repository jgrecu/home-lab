---
# Helm values for k8s-gateway (k8s-gateway).
fullnameOverride: k8s-gateway
ttl: 1
resources:
  requests:
    cpu: 15m
    memory: 100Mi
  limits:
    memory: 256Mi
service:
  type: LoadBalancer
  port: 53
  annotations:
    lbipam.cilium.io/ips: "#{ cluster_dns_gateway_addr }#"
  externalTrafficPolicy: Cluster
watchedResources: ["HTTPRoute", "Service"]
