---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: lingarr-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: lingarr-secret
    creationPolicy: Owner
  data:
    - secretKey: radarr-api-key
      remoteRef:
        key: lingarr
        property: radarr-api-key
    - secretKey: sonarr-api-key
      remoteRef:
        key: lingarr
        property: sonarr-api-key
