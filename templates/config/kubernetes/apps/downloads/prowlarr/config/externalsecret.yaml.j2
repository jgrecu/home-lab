---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: prowlarr-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: prowlarr-secret
    creationPolicy: Owner
  data:
    - secretKey: api-key
      remoteRef:
        key: prowlarr
        property: api-key
