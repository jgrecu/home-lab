---
# BUG FIXES applied:
#   - moverResources.requests.memory: 283Mi → 256Mi (normalised to power-of-2)
#   - R2 schedule: "0 10 * * *" → "0 12 * * *" (aligned with all other R2 jobs)
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
components:
  - ../../../../components/volsync
resources:
  - ./secret.sops.yaml
  - ./secret-r2.sops.yaml
patches:
  - target:
      kind: ReplicationSource
      name: volsync-local
    patch: |
      - op: replace
        path: /metadata/name
        value: sabnzbd-config-backup
      - op: replace
        path: /metadata/namespace
        value: downloads
      - op: replace
        path: /spec/sourcePVC
        value: sabnzbd
      - op: replace
        path: /spec/trigger/schedule
        value: "0 3 * * *"
      - op: replace
        path: /spec/restic/repository
        value: sabnzbd-config-restic-secret
      - op: replace
        path: /spec/restic/capacity
        value: 1Gi
      - op: replace
        path: /spec/restic/moverResources/limits/memory
        value: 512Mi
      - op: replace
        path: /spec/restic/moverResources/requests/memory
        value: 256Mi
  - target:
      kind: ReplicationSource
      name: volsync-r2
    patch: |
      - op: replace
        path: /metadata/name
        value: sabnzbd-config-backup-r2
      - op: replace
        path: /metadata/namespace
        value: downloads
      - op: replace
        path: /spec/sourcePVC
        value: sabnzbd
      - op: replace
        path: /spec/restic/repository
        value: sabnzbd-config-r2-restic-secret
      - op: replace
        path: /spec/restic/capacity
        value: 1Gi
