---
# Helm values with the domain (fully encrypted) for app-template (homepage).
route:
  app:
    hostnames: ["homepage.#{ cloudflare_domain }#"]
controllers:
  homepage:
    containers:
      app:
        env:
          HOMEPAGE_ALLOWED_HOSTS: "homepage.#{ cloudflare_domain }#,homepage.default.svc.cluster.local:3000"
