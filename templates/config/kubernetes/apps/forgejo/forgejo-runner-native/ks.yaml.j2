---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: forgejo-runner-native
spec:
  # Uses infinoid's native Kubernetes backend fork (code.forgejo.org/infinoid/k8s-runner).
  # One pod per workflow job, one ephemeral container per step — no Docker socket,
  # no DinD, no plugin binary. The backend is built directly into the runner binary.
  #
  # Build time: ~3-4 min (init container clones + go build at pod startup).
  # See docs/DEFERRED.md for upstream PR status (pulls/1472).
  dependsOn:
    - name: forgejo
  interval: 1h
  path: ./kubernetes/apps/forgejo/forgejo-runner-native/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: forgejo
  wait: false
