---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: forgejo-runner-native
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: forgejo-runner-native
rules:
  # Native k8s backend: creates and monitors one pod per workflow job
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["create", "delete", "get", "list", "watch"]
  # Native k8s backend: exec into job pods to run each workflow step
  - apiGroups: [""]
    resources: ["pods/exec"]
    verbs: ["create", "get"]
  # Native k8s backend: stream step logs back to the runner
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: forgejo-runner-native
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: forgejo-runner-native
subjects:
  - kind: ServiceAccount
    name: forgejo-runner-native
