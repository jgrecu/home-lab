---
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-runner-secret
stringData:
  # Registration token from Forgejo admin UI:
  # Site Administration → Runners → Create new runner token
  token: "#{ forgejo_runner_secret }#"
  # Stable UUID identifying this runner instance to Forgejo.
  # Generated once at configure time; kept stable across pod restarts.
  uuid: "#{ forgejo_runner_uuid }#"
