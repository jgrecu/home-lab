---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app forgejo-runner
spec:
  chartRef:
    kind: OCIRepository
    name: forgejo-runner
  interval: 1h
  timeout: 10m
  postRenderers:
    - kustomize:
        patches:
          - patch: |
              - op: replace
                path: /spec/template/spec/serviceAccountName
                value: forgejo-runner
            target:
              kind: Deployment
              name: forgejo-runner
  values:
    defaultPodOptions:
      automountServiceAccountToken: true
    controllers:
      forgejo-runner:
        replicas: 1
        strategy: Recreate
        pod:
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: "OnRootMismatch"
          annotations:
            secret.reloader.stakater.com/reload: *app
        # Builds the gRPC plugin binary from source. The plugin has no public container
        # image (git.erwanleboucher.dev OCI registry requires auth). One binary only —
        # the runner itself uses the official upstream image directly.
        initContainers:
          build-plugin:
            image:
              repository: golang
              tag: 1.27-alpine
            command:
              - /bin/sh
              - -c
              - |
                set -e
                apk add --no-cache git
                git clone --depth 1 --branch v13.2.1 \
                  https://github.com/eleboucher/runner-k8s-plugin.git \
                  /tmp/plugin-src
                cd /tmp/plugin-src
                go build -o /plugin/forgejo-runner-k8s .
                chmod 755 /plugin/forgejo-runner-k8s
            securityContext:
              allowPrivilegeEscalation: false
              capabilities: { drop: ["ALL"] }
              runAsUser: 0
            resources:
              requests:
                cpu: 100m
                memory: 512Mi
              limits:
                memory: 1Gi
        containers:
          app:
            image:
              repository: data.forgejo.org/forgejo/runner
              tag: "13.2.1"
            command: ["/bin/sh", "-c"]
            args:
              - |
                set -e

                # Migrate: clear stale registration from old eleboucher fork (pluginsv2 config).
                if grep -q 'pluginsv2' /data/config.yaml 2>/dev/null; then
                  echo "Clearing stale fork registration (pluginsv2 detected)"
                  rm -f /data/.runner /data/config.yaml
                fi

                # Migrate: re-register if the kaniko label is not yet present.
                if [ -f /data/.runner ] && ! grep -q '"kaniko"' /data/.runner 2>/dev/null; then
                  echo "Adding kaniko label: re-registering runner"
                  rm -f /data/.runner
                fi

                # Write runner config pointing to the gRPC plugin sidecar via Unix socket.
                cat > /data/config.yaml <<'EOF'
                log:
                  level: info
                runner:
                  capacity: 4
                  timeout: 3h
                container:
                  docker_host: "-"
                plugins:
                  k8s:
                    address: "unix:///plugin/forgejo-runner-k8s.sock"
                    options:
                      namespace: forgejo
                      poll_timeout: 10m
                EOF

                # Wait for the plugin sidecar to create its gRPC Unix socket.
                until [ -S /plugin/forgejo-runner-k8s.sock ]; do
                  echo "Waiting for plugin socket..."
                  sleep 1
                done

                if [ ! -f /data/.runner ]; then
                  forgejo-runner register \
                    --no-interactive \
                    --config /data/config.yaml \
                    --instance "$FORGEJO_INSTANCE_URL" \
                    --token "$FORGEJO_RUNNER_REGISTRATION_TOKEN" \
                    --name "$HOSTNAME" \
                    --labels "ubuntu-latest:k8s:///config/podspec-default.yaml,ubuntu-22.04:k8s:///config/podspec-default.yaml,kaniko:k8s:///config/podspec-kaniko.yaml"
                fi
                exec forgejo-runner --config /data/config.yaml daemon
            env:
              HOME: /data
              FORGEJO_INSTANCE_URL: "http://forgejo-http.forgejo.svc.cluster.local:3000"
              FORGEJO_RUNNER_REGISTRATION_TOKEN:
                valueFrom:
                  secretKeyRef:
                    name: forgejo-runner-secret
                    key: registration-token
            securityContext:
              allowPrivilegeEscalation: false
              capabilities: { drop: ["ALL"] }
              runAsUser: 1000
              runAsGroup: 1000
            resources:
              requests:
                cpu: 15m
                memory: 256Mi
              limits:
                memory: 1Gi

          # gRPC plugin sidecar — handles all job pod lifecycle on behalf of the runner.
          # Binary built by the init container; communicates via Unix socket on shared /plugin emptyDir.
          plugin:
            image:
              repository: alpine
              tag: "3.24"
            command:
              - /plugin/forgejo-runner-k8s
              - --listen
              - unix:///plugin/forgejo-runner-k8s.sock
            securityContext:
              allowPrivilegeEscalation: false
              capabilities: { drop: ["ALL"] }
              runAsUser: 1000
              runAsGroup: 1000
            resources:
              requests:
                cpu: 5m
                memory: 32Mi
              limits:
                memory: 128Mi

    persistence:
      # Stores runner registration state (.runner file), config.yaml, and act cache.
      data:
        type: persistentVolumeClaim
        storageClass: longhorn
        size: 1Gi
        accessMode: ReadWriteOnce
        globalMounts:
          - path: /data
      # Shared emptyDir for the Unix socket between runner and plugin sidecar.
      plugin:
        type: emptyDir
        globalMounts:
          - path: /plugin
      # PodSpec YAML files for CI job pod customization, referenced by runner labels.
      podspec:
        type: configMap
        name: forgejo-runner-podspecs
        globalMounts:
          - path: /config
            readOnly: true
