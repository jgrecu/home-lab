---
# Helm values for forgejo-runner (forgejo-runner).
replicaCount: 1

image:
  repository: data.forgejo.org/forgejo/runner
  tag: "13.2.1"
  pullPolicy: IfNotPresent

    # Plugin image — pre-built binary, no golang build step at pod start.
    # Multi-arch: linux/amd64 (18 MiB) + linux/arm64 (17 MiB).
plugin:
  image:
    repository: git.erwanleboucher.dev/eleboucher/runner-k8s-plugin
    tag: "13.2.1"
    pullPolicy: IfNotPresent
  resources:
    requests:
      cpu: 5m
      memory: 32Mi
    limits:
      memory: 128Mi

forgejo:
  url: "http://forgejo-http.forgejo.svc.cluster.local:3000"
  existingSecret: forgejo-runner-secret
  secretKeys:
    token: token
    uuid: uuid

resources:
  requests:
    cpu: 15m
    memory: 256Mi
  limits:
    memory: 1Gi

podSecurityContext:
  fsGroup: 1000
  fsGroupChangePolicy: OnRootMismatch
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000

securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop: ["ALL"]
  readOnlyRootFilesystem: true

terminationGracePeriodSeconds: 300

    # RBAC is managed by the chart (Role + RoleBinding in the release namespace).
rbac:
  create: true

serviceAccount:
  create: true
  automount: true

    # Full runner.yaml. Plugin sidecar listens on plugin.socketPath (default:
    # /plugin/forgejo-runner-k8s.sock). Cache enabled — stored on the data PVC.
runnerConfig: |
  log:
    level: info
  runner:
    capacity: 4
    timeout: 3h
    shutdown_timeout: 3m
    labels:
      - "ubuntu-latest:k8s:///config/podspec-default.yaml"
      - "ubuntu-22.04:k8s:///config/podspec-default.yaml"
      - "kaniko:k8s:///config/podspec-kaniko.yaml"
  container:
    docker_host: "-"
  cache:
    enabled: true
    dir: /data/cache
    port: 8088
    proxy_port: 8089
  plugins:
    k8s:
      address: "unix:///plugin/forgejo-runner-k8s.sock"
      options:
        namespace: forgejo
        poll_timeout: 10m
        resources: |
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            memory: 1Gi



podSpecs:
      # Default: Ubuntu 24.04 image with Node.js, git, and common CI tools.
      # Required for JavaScript actions (actions/checkout needs `node` on PATH).
  podspec-default.yaml: |
    containers:
      - name: main
        image: ghcr.io/bjw-s-labs/forgejo-runner:ubuntu-24.04
        imagePullPolicy: IfNotPresent
        env:
          - name: DEBIAN_FRONTEND
            value: noninteractive
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            memory: 1Gi
    restartPolicy: Never





  podspec-kaniko.yaml: |
    containers:
      - name: main
        image: gcr.io/kaniko-project/executor:debug
        imagePullPolicy: IfNotPresent
        securityContext:
          runAsUser: 0
          runAsGroup: 0
        resources:
          requests:
            cpu: 200m
            memory: 512Mi
          limits:
            memory: 2Gi
    restartPolicy: Never
