          "targets": [{"columns": [{"selector": "latitude", "text": "Latitude", "type": "number"}, {"selector": "longitude", "text": "Longitude", "type": "number"}, {"selector": "time", "text": "Timestamp", "type": "timestamp"}], "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "health-auto-export"}, "filters": [], "format": "table", "global_query_id": "", "parser": "backend", "refId": "Workout Route", "root_selector": "route", "source": "url", "type": "json", "url": "/api/workouts/$${selected_workout}", "url_options": {"data": "", "method": "GET"}}],
          "title": "Workout Route",
          "type": "geomap"
        },
        {
