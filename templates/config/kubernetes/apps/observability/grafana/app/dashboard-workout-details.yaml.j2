apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-workout-details
  namespace: observability
  labels:
    grafana_dashboard: "1"
  annotations:
    grafana_folder: Health
data:
  workout-details.json: |-
    {
      "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 0,
      "links": [],
      "panels": [
        {
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "health-auto-export"},
          "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
          "gridPos": {"h": 12, "w": 12, "x": 0, "y": 0},
