---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-fitness-sleep
  namespace: observability
  labels:
    grafana_dashboard: "1"
    grafana_folder: "Fitness"
data:
  fitness-sleep-analysis.json: |-
    {
      "title": "Fitness - Sleep Analysis",
      "uid": "fitness-sleep-analysis",
      "timezone": "browser",
      "refresh": "1h",
      "time": {"from": "now-90d", "to": "now"},
      "panels": [
        {
          "title": "Sleep Duration (Garmin)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
          "datasource": {"type": "influxdb", "uid": "InfluxDB-Fitness"},
          "targets": [{
            "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"duration_sec\")\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))\n  |> yield(name: \"sleep_hours\")",
            "refId": "A"
          }],
          "fieldConfig": {"defaults": {"unit": "h", "color": {"fixedColor": "dark-blue", "mode": "fixed"}, "thresholds": {"steps": [{"value": 6, "color": "red"}, {"value": 7, "color": "yellow"}, {"value": 8, "color": "green"}]}}}
        },
        {
          "title": "Sleep Score (Garmin)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
          "datasource": {"type": "influxdb", "uid": "InfluxDB-Fitness"},
          "targets": [{
            "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"score\")\n  |> yield(name: \"sleep_score\")",
            "refId": "A"
          }],
          "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 100, "color": {"fixedColor": "purple", "mode": "fixed"}}}
        },
        {
          "title": "Sleep Stages (Garmin)",
          "type": "barchart",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
          "datasource": {"type": "influxdb", "uid": "InfluxDB-Fitness"},
          "targets": [
            {
              "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"deep_sec\")\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))\n  |> yield(name: \"deep\")",
              "refId": "A"
            },
            {
              "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"light_sec\")\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))\n  |> yield(name: \"light\")",
              "refId": "B"
            },
            {
              "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"rem_sec\")\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))\n  |> yield(name: \"rem\")",
              "refId": "C"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "h", "color": {"mode": "palette-classic"}}}
        },
        {
          "title": "Sleep SpO2 (Garmin)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
          "datasource": {"type": "influxdb", "uid": "InfluxDB-Fitness"},
          "targets": [{
            "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"avg_spo2\")\n  |> yield(name: \"sleep_spo2\")",
            "refId": "A"
          }],
          "fieldConfig": {"defaults": {"unit": "percent", "min": 90, "max": 100, "color": {"fixedColor": "purple", "mode": "fixed"}}}
        },
        {
          "title": "Sleep Respiration (Garmin)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
          "datasource": {"type": "influxdb", "uid": "InfluxDB-Fitness"},
          "targets": [{
            "query": "from(bucket: \"health_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sleep\" and r._field == \"avg_respiration\")\n  |> yield(name: \"sleep_resp\")",
            "refId": "A"
          }],
          "fieldConfig": {"defaults": {"unit": "breathspm", "color": {"fixedColor": "cyan", "mode": "fixed"}}}
        }
      ],
      "schemaVersion": 39
    }
