---
# Helm values with the domain (fully encrypted) for grafana (grafana).
route:
  main:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/group: Observability
      gethomepage.dev/name: Grafana
      gethomepage.dev/icon: grafana.png
      gethomepage.dev/description: Metrics visualization platform
      gethomepage.dev/href: "https://grafana.#{ cloudflare_domain }#"
    hostnames: ["grafana.#{ cloudflare_domain }#"]
