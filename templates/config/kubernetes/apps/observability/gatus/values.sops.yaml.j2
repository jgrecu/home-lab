---
# Helm values with the domain (fully encrypted) for app-template (gatus).
route:
  app:
    hostnames: ["gatus.#{ cloudflare_domain }#"]
    annotations:
      gethomepage.dev/href: "https://gatus.#{ cloudflare_domain }#"
configMaps:
  config:
    data:
      config.yaml: |
        # Gatus status page configuration.
        # Add an entry per service you want to monitor.
        # Gatus checks each endpoint on the defined interval and
        # shows a status page with uptime history and response times.
        #
        # Full docs: https://github.com/TwiN/gatus#configuration

        web:
          port: 8080

        metrics: true

        storage:
          type: sqlite
          path: /data/gatus.db

        endpoints:
          # CloudFlare IP Blocking Detection (LaLiga anti-piracy)
          # Spanish ISPs block ~3,000 CloudFlare IPs during matches
          # "via CloudFlare" checks monitor external access through CloudFlare tunnel (2min interval, strict response times)
          # Regular checks monitor internal cluster services directly (5min interval, basic health)
          - name: CloudFlare Infrastructure
            group: CloudFlare
            url: "https://www.cloudflare.com"
            interval: 2m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 2000"

          - name: CloudFlare API
            group: CloudFlare
            url: "https://api.cloudflare.com/client/v4/ips"
            interval: 2m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 3000"

          - name: CloudFlare Tunnel
            group: CloudFlare
            url: "http://cloudflare-tunnel.network.svc.cluster.local:8080/ready"
            interval: 2m
            conditions:
              - "[STATUS] == 200"

          - name: Immich (via CloudFlare)
            group: CloudFlare
            url: "https://immich.#{ cloudflare_domain }#"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 5000"

          - name: Nextcloud (via CloudFlare)
            group: CloudFlare
            url: "https://nextcloud.#{ cloudflare_domain }#/status.php"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
              - "[BODY].installed == true"
              - "[RESPONSE_TIME] < 5000"

          - name: Linkding (via CloudFlare)
            group: CloudFlare
            url: "https://linkding.#{ cloudflare_domain }#/health"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 5000"

          - name: Forgejo (via CloudFlare)
            group: CloudFlare
            url: "https://forgejo.#{ cloudflare_domain }#"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 5000"

          - name: Kavita (via CloudFlare)
            group: CloudFlare
            url: "https://kavita.#{ cloudflare_domain }#"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 5000"

          - name: Grimmory (via CloudFlare)
            group: CloudFlare
            url: "https://grimmory.#{ cloudflare_domain }#/api/v1/healthcheck"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 5000"

          - name: Docker Hub
            group: CloudFlare
            url: "https://registry-1.docker.io/v2/"
            interval: 2m
            conditions:
              - "[STATUS] == 401"
              - "[RESPONSE_TIME] < 5000"

          - name: CloudFlare Status
            group: CloudFlare
            url: "https://www.cloudflarestatus.com"
            interval: 5m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 3000"

          # Observability
          - name: Grafana
            group: Observability
            url: "http://grafana.observability.svc.cluster.local"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          # Internal Services
          - name: Homepage
            group: Internal
            url: "http://homepage.default.svc.cluster.local:3000"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          # Internal Service Health Checks
          # These check the services directly within the cluster (bypassing CloudFlare)
          - name: Immich
            group: Internal Services
            url: "http://immich-server.entertainment.svc.cluster.local:2283/api/server/ping"
            interval: 5m
            conditions:
              - "[STATUS] == 200"
              - "[BODY].res == pong"

          - name: Nextcloud
            group: Internal Services
            url: "http://nextcloud.cloud.svc.cluster.local:80/status.php"
            interval: 5m
            conditions:
              - "[STATUS] == 200"
              - "[BODY].installed == true"

          - name: Linkding
            group: Internal Services
            url: "http://linkding.cloud.svc.cluster.local:9090/health"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Forgejo
            group: Internal Services
            url: "http://forgejo-http.forgejo.svc.cluster.local:3000"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Woodpecker CI
            group: Internal Services
            url: "http://woodpecker-server.woodpecker.svc.cluster.local:8000/healthz"
            interval: 5m
            conditions:
              - "[STATUS] == 204"

          - name: Kavita
            group: Internal Services
            url: "http://kavita.entertainment.svc.cluster.local:5000"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Grimmory
            group: Internal Services
            url: "http://grimmory.entertainment.svc.cluster.local:6060/api/v1/healthcheck"
            interval: 5m
            conditions:
              - "[STATUS] == 200"
              - "[BODY].status == 200"

          # Downloads - Media Management
          - name: Sonarr
            group: Downloads
            url: "http://sonarr.downloads.svc.cluster.local:8989/ping"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Radarr
            group: Downloads
            url: "http://radarr.downloads.svc.cluster.local:7878/ping"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Prowlarr
            group: Downloads
            url: "http://prowlarr.downloads.svc.cluster.local:9696"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Bazarr
            group: Downloads
            url: "http://bazarr.downloads.svc.cluster.local:6767"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: Transmission
            group: Downloads
            url: "http://transmission-app.downloads.svc.cluster.local:9091"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: SABnzbd
            group: Downloads
            url: "http://sabnzbd.downloads.svc.cluster.local:8080"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          # Entertainment - Media Consumption
          - name: Jellyfin
            group: Entertainment
            url: "http://jellyfin.entertainment.svc.cluster.local:8096/health"
            interval: 5m
            conditions:
              - "[STATUS] == 200"
              - "[RESPONSE_TIME] < 3000"

          - name: Seerr
            group: Entertainment
            url: "http://seerr.entertainment.svc.cluster.local:5055/api/v1/status"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          # Home Automation
          - name: Home Assistant
            group: Home Automation
            url: "http://home-assistant.home-automation.svc.cluster.local:8123"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          # Infrastructure
          - name: Pi-hole
            group: Infrastructure
            url: "http://pihole-web.network.svc.cluster.local/admin/"
            interval: 5m
            conditions:
              - "[STATUS] == 200"

          - name: NFS Media Server
            group: Infrastructure
            url: "tcp://192.168.1.37:2049"
            interval: 3m
            conditions:
              - "[CONNECTED] == true"

          - name: Dragonfly Cache
            group: Infrastructure
            url: "tcp://dragonfly.database-system.svc.cluster.local:6379"
            interval: 3m
            conditions:
              - "[CONNECTED] == true"

          - name: SeaweedFS S3
            group: Infrastructure
            url: "http://seaweedfs-filer.storage.svc.cluster.local:8333"
            interval: 3m
            conditions:
              - "[STATUS] == 403"

          - name: SeaweedFS Master
            group: Infrastructure
            url: "http://seaweedfs-master.storage.svc.cluster.local:9333/cluster/status"
            interval: 3m
            conditions:
              - "[STATUS] == 200"
