---
# Helm values for fluent-bit (fluent-bit).
    # Fluent Bit runs as a DaemonSet — one pod per node — collecting container
    # logs from /var/log/containers and shipping them to Loki.
kind: DaemonSet

    # Enable Prometheus metrics scraping
serviceMonitor:
  enabled: true
  interval: 30s

config:
      # Read container logs written by the container runtime (containerd uses CRI format)
  inputs: |
    [INPUT]
        Name              tail
        Path              /var/log/containers/*.log
        multiline.parser  docker, cri
        Tag               kube.*
        Mem_Buf_Limit     50MB
        Skip_Long_Lines   On



  filters: |
    [FILTER]
        Name                kubernetes
        Match               kube.*
        Merge_Log           On
        Keep_Log            Off
        K8S-Logging.Parser  On
        K8S-Logging.Exclude On

    # Drop noisy health-check and readiness probe logs to reduce volume
    [FILTER]
        Name    grep
        Match   kube.*
        Exclude log .*GET /health.*
        Exclude log .*GET /readyz.*
        Exclude log .*GET /livez.*

    # Drop logs from high-volume namespaces that are rarely inspected.
    # This significantly reduces Loki storage consumption.
    [FILTER]
        Name    grep
        Match   kube.*
        Exclude $kubernetes['namespace_name'] ^(downloads|entertainment|storage)$



  outputs: |
    [OUTPUT]
        Name                   loki
        Match                  kube.*
        Host                   loki-gateway.observability.svc.cluster.local
        Port                   80
        Labels                 job=fluent-bit
        auto_kubernetes_labels on
        line_format            json


volumeMounts:
  - name: varlog
    mountPath: /var/log

volumes:
  - name: varlog
    hostPath:
      path: /var/log

tolerations:
      # Run on control-plane nodes too so their logs are captured
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

resources:
  requests:
    cpu: 35m
    memory: 512Mi
  limits:
    memory: 1Gi
