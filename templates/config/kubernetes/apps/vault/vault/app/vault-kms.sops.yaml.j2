---
apiVersion: v1
kind: Secret
metadata:
  name: vault-kms
  namespace: vault
type: Opaque
stringData:
  AWS_REGION: "#{ vault_kms_aws_region }#"
  VAULT_AWSKMS_SEAL_KEY_ID: "#{ vault_kms_key_id }#"
  AWS_ACCESS_KEY_ID: "#{ vault_kms_access_key_id }#"
  AWS_SECRET_ACCESS_KEY: "#{ vault_kms_secret_access_key }#"
