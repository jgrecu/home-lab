---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: health-auto-export-mongodb-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: health-auto-export-mongodb-secret
    creationPolicy: Owner
  data:
    - secretKey: username
      remoteRef:
        key: health-auto-export-mongodb
        property: username
    - secretKey: password
      remoteRef:
        key: health-auto-export-mongodb
        property: password
