---
# Helm values for app-template (health-auto-export-mongodb).
controllers:
  mongodb:
    strategy: Recreate
    pod:
      annotations:
        secret.reloader.stakater.com/reload: health-auto-export-mongodb-secret
    containers:
      app:
        image:
          repository: docker.io/mongo
              # renovate: datasource=docker depName=docker.io/mongo
          tag: "9.0.4"
        env:
          MONGO_INITDB_ROOT_USERNAME:
            valueFrom:
              secretKeyRef:
                name: health-auto-export-mongodb-secret
                key: username
          MONGO_INITDB_ROOT_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: health-auto-export-mongodb-secret
                key: password
          MONGO_INITDB_DATABASE: health-auto-export
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              exec:
                command:
                  - mongosh
                  - --eval
                  - "db.adminCommand('ping')"
              initialDelaySeconds: 30
              periodSeconds: 30
              timeoutSeconds: 5
              failureThreshold: 5
          readiness:
            enabled: false
        resources:
          requests:
            cpu: 50m
            memory: 256Mi
          limits:
            memory: 512Mi

persistence:
  data:
    type: persistentVolumeClaim
    storageClass: longhorn
    size: 2Gi
    accessMode: ReadWriteOnce
    globalMounts:
      - path: /data/db

service:
  app:
    ports:
      mongodb:
        port: 27017
