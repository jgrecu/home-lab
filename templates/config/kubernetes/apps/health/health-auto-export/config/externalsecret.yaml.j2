---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: health-auto-export-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: health-auto-export-secret
    creationPolicy: Owner
  data:
    - secretKey: mongo-username
      remoteRef:
        key: health-auto-export
        property: mongo-username
    - secretKey: mongo-password
      remoteRef:
        key: health-auto-export
        property: mongo-password
    - secretKey: read-token
      remoteRef:
        key: health-auto-export
        property: read-token
    - secretKey: write-token
      remoteRef:
        key: health-auto-export
        property: write-token
