---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
components:
  - ../../../../components/volsync
resources:
  - ./secret.sops.yaml
  - ./secret-r2.sops.yaml
patches:
  - target:
      kind: ReplicationSource
      name: volsync-local
    patch: |
      - op: replace
        path: /metadata/name
        value: jellyfin-config-backup
      - op: replace
        path: /metadata/namespace
        value: entertainment
      - op: replace
        path: /spec/sourcePVC
        value: jellyfin
      - op: replace
        path: /spec/trigger/schedule
        value: "0 6 * * *"
      - op: replace
        path: /spec/restic/repository
        value: jellyfin-config-restic-secret
      - op: replace
        path: /spec/restic/capacity
        value: 10Gi
      - op: replace
        path: /spec/restic/cacheCapacity
        value: 1Gi
      - op: replace
        path: /spec/restic/moverResources/limits/memory
        value: 512Mi
      - op: replace
        path: /spec/restic/moverResources/requests/memory
        value: 256Mi
  - target:
      kind: ReplicationSource
      name: volsync-r2
    patch: |
      - op: replace
        path: /metadata/name
        value: jellyfin-config-backup-r2
      - op: replace
        path: /metadata/namespace
        value: entertainment
      - op: replace
        path: /spec/sourcePVC
        value: jellyfin
      - op: replace
        path: /spec/restic/repository
        value: jellyfin-config-r2-restic-secret
      - op: replace
        path: /spec/restic/capacity
        value: 10Gi
      - op: replace
        path: /spec/restic/cacheCapacity
        value: 2Gi
      - op: replace
        path: /spec/restic/moverResources/limits/memory
        value: 1Gi
      - op: replace
        path: /spec/restic/moverResources/requests/memory
        value: 512Mi
