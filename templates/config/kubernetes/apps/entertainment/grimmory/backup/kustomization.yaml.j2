---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
components:
  - ../../../../components/volsync
resources:
  - ./secret.sops.yaml
  - ./secret-r2.sops.yaml
patches:
  - target:
      kind: ReplicationSource
      name: volsync-local
    patch: |
      - op: replace
        path: /metadata/name
        value: grimmory-data-backup
      - op: replace
        path: /metadata/namespace
        value: entertainment
      - op: replace
        path: /spec/sourcePVC
        value: grimmory-data
      - op: replace
        path: /spec/trigger/schedule
        value: "0 5 * * *"
      - op: replace
        path: /spec/restic/repository
        value: grimmory-data-restic-secret
      - op: replace
        path: /spec/restic/capacity
        value: 500Mi
  - target:
      kind: ReplicationSource
      name: volsync-r2
    patch: |
      - op: replace
        path: /metadata/name
        value: grimmory-data-backup-r2
      - op: replace
        path: /metadata/namespace
        value: entertainment
      - op: replace
        path: /spec/sourcePVC
        value: grimmory-data
      - op: replace
        path: /spec/restic/repository
        value: grimmory-data-r2-restic-secret
      - op: replace
        path: /spec/restic/capacity
        value: 500Mi
      - op: replace
        path: /spec/restic/cacheCapacity
        value: 256Mi
