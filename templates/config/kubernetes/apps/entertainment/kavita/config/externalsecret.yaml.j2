---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: kavita-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: kavita-secret
    creationPolicy: Owner
  data:
    - secretKey: oidc-client-secret
      remoteRef:
        key: kavita
        property: oidc-client-secret
