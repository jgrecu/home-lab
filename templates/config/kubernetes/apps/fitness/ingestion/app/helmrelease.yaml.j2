---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: fitness-ingestion
spec:
  chartRef:
    kind: OCIRepository
    name: fitness-ingestion
  interval: 1h
  values:
    controllers:
      fitness-ingestion:
        strategy: Recreate
        containers:
          app:
            image:
              repository: forgejo.${SECRET_DOMAIN}/jeremy/fitness-ingestion
              # Updated by Woodpecker CI on each push
              tag: 61a04e75
            envFrom:
              - secretRef:
                  name: fitness-ingestion-secret
            env:
              TZ: "Europe/Madrid"
            probes:
              liveness: &probes
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: /health
                    port: &port 8000
                  initialDelaySeconds: 10
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 5
              readiness: *probes
            resources:
              requests:
                cpu: 15m
                memory: 256Mi
              limits:
                memory: 2Gi

    defaultPodOptions:
      securityContext:
        fsGroup: 1000
        fsGroupChangePolicy: "Always"

    persistence:
      config:
        type: persistentVolumeClaim
        storageClass: longhorn
        size: 512Mi
        accessMode: ReadWriteOnce
        globalMounts:
          - path: /app/data

    service:
      app:
        ports:
          http:
            port: *port

    route:
      # Internal route for Grafana/CronJob access
      internal:
        hostnames: ["fitness-ingest.${SECRET_DOMAIN}"]
        annotations:
          gethomepage.dev/enabled: "true"
          gethomepage.dev/name: "Fitness Ingestion"
          gethomepage.dev/group: "Fitness"
          gethomepage.dev/description: "Health data pipeline"
          gethomepage.dev/icon: "mdi-heart-pulse"
          gethomepage.dev/href: "https://fitness-ingest.${SECRET_DOMAIN}"
        parentRefs:
          - name: envoy-internal
            namespace: network
            sectionName: https
        rules:
          - backendRefs:
              - identifier: app
                port: *port
      # External route for Apple Health webhook (via Cloudflare Tunnel)
      external:
        hostnames: ["fitness-ingest.${SECRET_DOMAIN}"]
        parentRefs:
          - name: envoy-external
            namespace: network
            sectionName: https
        rules:
          - matches:
              - path:
                  type: PathPrefix
                  value: /api/apple
            backendRefs:
              - identifier: app
                port: *port
          - matches:
              - path:
                  type: PathPrefix
                  value: /api/withings
            backendRefs:
              - identifier: app
                port: *port
