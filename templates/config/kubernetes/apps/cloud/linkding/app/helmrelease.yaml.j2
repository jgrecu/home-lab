---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: linkding
spec:
  chartRef:
    kind: OCIRepository
    name: linkding
  interval: 1h
  values:
    defaultPodOptions:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault

    controllers:
      linkding:
        containers:
          app:
            image:
              repository: sissbruecker/linkding
              tag: 1.46.2
            env:
              # Initial superuser — only used on first boot.
              # After init, credentials are stored in the SQLite database.
              LD_SUPERUSER_NAME: admin
              LD_SUPERUSER_PASSWORD:
                valueFrom:
                  secretKeyRef:
                    name: linkding-secret
                    key: admin-password
            probes:
              liveness: &probes
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: /health
                    port: &port 9090
                  initialDelaySeconds: 10
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 5
              readiness: *probes
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop: ["ALL"]
            resources:
              requests:
                cpu: 15m
                memory: 128Mi
              limits:
                memory: 512Mi

      # ── Healthcheck CronJob ────────────────────────────────────────────────────
      # Runs monthly, hits every bookmark via the Linkding REST API, and tags
      # dead/broken links with @HEALTH_HTTP_<code>, @HEALTH_DNS, or @HEALTH_other.
      # Also detects duplicate bookmarks.
      #
      # Prerequisites (one-time after first deploy):
      #   1. Log into Linkding → Settings → Integrations → copy API Token
      #   2. Set linkding_healthcheck_token in cluster.yaml
      #   3. Run: task configure --yes && git commit && git push
      healthcheck:
        type: cronjob
        cronjob:
          schedule: "0 3 1 * *"   # 3 AM on the 1st of each month
          concurrencyPolicy: Forbid
          failedJobsHistory: 3
          successfulJobsHistory: 1
        containers:
          app:
            image:
              repository: ghcr.io/sebw/ldhc
              tag: 0.2.2
            env:
              API_TOKEN:
                valueFrom:
                  secretKeyRef:
                    name: linkding-secret
                    key: healthcheck-token
              # Internal service URL — stays within the cluster, no Cloudflare hop
              API_URL: "http://linkding.cloud.svc.cluster.local:9090/api/bookmarks"
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop: ["ALL"]
            resources:
              requests:
                cpu: 50m
                memory: 64Mi
              limits:
                memory: 256Mi

    persistence:
      # SQLite database + uploaded favicons stored on Longhorn.
      # Survives pod restarts. Longhorn handles replication across nodes.
      data:
        type: persistentVolumeClaim
        storageClass: longhorn
        size: 2Gi
        accessMode: ReadWriteOnce
        globalMounts:
          - path: /etc/linkding/data

    service:
      app:
        controller: linkding
        ports:
          http:
            port: *port

    route:
      app:
        parentRefs:
          - name: envoy-external
            namespace: network
            sectionName: https
        hostnames: ["linkding.${SECRET_DOMAIN}"]
        rules:
          - backendRefs:
              - identifier: app
                port: *port
        annotations:
          gethomepage.dev/enabled: "true"
          gethomepage.dev/group: Cloud
          gethomepage.dev/name: Linkding
          gethomepage.dev/icon: linkding.png
          gethomepage.dev/description: Self-hosted bookmark manager
          gethomepage.dev/href: "https://linkding.${SECRET_DOMAIN}"
