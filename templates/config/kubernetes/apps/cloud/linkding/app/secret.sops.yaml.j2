---
apiVersion: v1
kind: Secret
metadata:
  name: linkding-secret
stringData:
  admin-password: "#{ linkding_admin_password }#"
  # API token for linkding-healthcheck CronJob.
  # Obtain after first deploy: Linkding → Settings → Integrations → API Token
  # Then update cluster.yaml and run: task configure --yes
  healthcheck-token: "#{ linkding_healthcheck_token }#"
