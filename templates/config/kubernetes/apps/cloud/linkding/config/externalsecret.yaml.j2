---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: linkding-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault
    kind: ClusterSecretStore
  target:
    name: linkding-secret
    creationPolicy: Owner
  data:
    - secretKey: admin-password
      remoteRef:
        key: linkding
        property: admin-password
    - secretKey: healthcheck-token
      remoteRef:
        key: linkding
        property: healthcheck-token
