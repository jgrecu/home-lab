---
# Persistent Nextcloud configuration mounted at /var/www/html/config/custom.config.php
# Survives pod restarts, image upgrades, and full reinstalls.
# Nextcloud merges all *.config.php files in /var/www/html/config/ automatically.
apiVersion: v1
kind: ConfigMap
metadata:
  name: nextcloud-custom-config
data:
  custom.config.php: |
    <?php
    $CONFIG = [
      // Reverse proxy (Envoy Gateway via Cloudflare Tunnel)
      'trusted_proxies'        => ['10.42.0.0/16', '10.43.0.0/16'],
      'forwarded_for_headers'  => ['HTTP_X_FORWARDED_FOR'],
      'overwriteprotocol'      => 'https',
      'overwrite.cli.url'      => 'https://nextcloud.#{cluster.nextcloud.hostname}#',
    ];
