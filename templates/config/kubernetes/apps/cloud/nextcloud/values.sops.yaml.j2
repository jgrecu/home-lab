---
# Helm values with the domain (fully encrypted) for app-template (nextcloud).
route:
  app:
    hostnames: ["nextcloud.#{ cloudflare_domain }#"]
    annotations:
      gethomepage.dev/href: https://nextcloud.#{ cloudflare_domain }#
controllers:
  nextcloud:
    containers:
      app:
        env:
          NEXTCLOUD_TRUSTED_DOMAINS: "nextcloud.#{ cloudflare_domain }#"
