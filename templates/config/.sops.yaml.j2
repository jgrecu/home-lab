---
creation_rules:
  - path_regex: talos/.*\.sops\.ya?ml
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
  # Helm values that contain the domain: encrypt the WHOLE file (helm-secrets in Argo CD)
  - path_regex: kubernetes/.*values\.sops\.ya?ml
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
  - path_regex: (bootstrap|kubernetes)/.*\.sops\.ya?ml
    # spec: non-Secret manifests carrying the domain (HTTPRoute, Certificate, ...) via ksops
    encrypted_regex: "^(data|stringData|spec)$"
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
stores:
  yaml:
    indent: 2
